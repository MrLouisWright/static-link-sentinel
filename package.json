{
  "name": "static-link-sentinel",
  "version": "1.1.0",
  "description": "Crawl a static build (dist/, build/, out/, public/, _site/) before deploy and fail CI on broken internal links, missing assets, case-mismatched paths, missing #anchors and dead or redirecting external links. CLI, API, Vite and webpack plugins, GitHub Action. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    },
    "./vite": {
      "types": "./dist/types/vite.d.ts",
      "import": "./src/vite.js",
      "require": "./dist/vite.cjs",
      "default": "./src/vite.js"
    },
    "./webpack": {
      "types": "./src/webpack.d.ts",
      "import": "./src/webpack.mjs",
      "require": "./src/webpack.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "static-link-sentinel": "bin/static-link-sentinel.js"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "broken-links",
    "link-checker",
    "dead-links",
    "404",
    "static-site",
    "dist",
    "ci",
    "vite",
    "vite-plugin",
    "webpack-plugin",
    "netlify",
    "vercel",
    "astro",
    "eleventy",
    "hugo",
    "nextjs",
    "sitemap",
    "redirects",
    "sarif",
    "github-action",
    "markdown"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/static-link-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/static-link-sentinel/issues"
  },
  "homepage": "https://mrlouiswright.github.io/static-link-sentinel/"
}
